# Vercel Blob private store — lấy qua `vercel link` + `vercel env pull` sau khi
# tạo store (dashboard hoặc `vercel blob create-store <name> --access private`).
BLOB_READ_WRITE_TOKEN=

# Secret dùng chung để chặn người lạ gọi /api/sync — tự sinh 1 chuỗi ngẫu nhiên
# đủ dài (ví dụ `openssl rand -hex 32`), đặt cùng giá trị ở đây và ở
# Vercel dashboard → Settings → Environment Variables khi deploy thật.
SYNC_SECRET=

# Cloudinary (gói Free) lưu ảnh trang Plan cuộc đời — Console → trang API Keys có
# đủ Cloud name, API Key, API Secret. Đặt cùng giá trị ở Vercel dashboard
# (Production) khi deploy thật. Thiếu biến nào thì ghi chép bằng chữ vẫn chạy,
# chỉ nút thêm ảnh bị khoá.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
